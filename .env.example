DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
DATABASE_URL_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_ADMIN_URL=sd
DJANGO_LOG_LEVEL=INFO
SITE_EMAIL=
SITE_PHONE=
SITE_WHATSAPP=
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
SOCIAL_TWITTER=
SOCIAL_LINKEDIN=
SOCIAL_FACEBOOK=
# --- Production hardening / infrastructure ---
REDIS_URL=redis://127.0.0.1:6379/0
TRUSTED_PROXY_COUNT=1           # number of reverse proxies in front of Django (nginx / load balancer)
DJANGO_SSL_REDIRECT=1           # leave 1 in production; 0 only to simulate prod locally over http
DJANGO_HSTS_PRELOAD=0           # set 1 only when you are sure the domain should be HSTS-preloaded
DJANGO_ALLOW_SQLITE=0           # production requires PostgreSQL (DATABASE_URL_NAME)
